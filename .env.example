# Copy to .env.local to override. Both are read at build time.

# Path prefix the site is served under. Default /docs (https://orcher.io/docs).
# Set to an empty value to serve from the root, e.g. at docs.orcher.io.
NEXT_PUBLIC_BASE_PATH=/docs

# Public origin, used for canonical URLs and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://orcher.io
